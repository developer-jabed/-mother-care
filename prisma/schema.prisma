generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  password           String
  role               UserRole
  isEmailVerified    Boolean   @default(false)
  lastLogin          DateTime?
  needPasswordChange Boolean   @default(true)
  isActive           Boolean   @default(true)
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  adminProfile       Admin?
  studentProfile     Student?
}

model Admin {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  fullName    String
  phone       String?
  photo       String?
  designation String?
  joiningDate DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  feePayments FeePayment[]
}

model AcademicYear {
  id            Int                 @id @default(autoincrement())
  title         String              @unique
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  exams         Exam[]
  gradingScales GradingScale[]
  enrollments   StudentEnrollment[]
  feeStructures FeeStructure[]

  @@index([isCurrent])
}

model Class {
  id            Int                 @id @default(autoincrement())
  name          String
  numericOrder  Int?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  classSubjects ClassSubject[]
  examSchedules ExamSchedule[]
  sections      Section[]
  enrollments   StudentEnrollment[]
  feeStructures FeeStructure[]
}

model Section {
  id            Int                 @id @default(autoincrement())
  classId       Int
  name          String
  capacity      Int?
  classSubjects ClassSubject[]
  class         Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments   StudentEnrollment[]

  @@unique([classId, name])
}

model Student {
  id              Int                 @id @default(autoincrement())
  userId          Int?                @unique
  admissionNumber String              @unique
  fullName        String
  fatherName      String?
  motherName      String?
  gender          Gender
  dateOfBirth     DateTime
  phone           String?
  address         String?
  photo           String?
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User?               @relation(fields: [userId], references: [id])
  enrollments     StudentEnrollment[]
}

model StudentEnrollment {
  id             Int                 @id @default(autoincrement())
  studentId      Int
  academicYearId Int
  classId        Int
  sectionId      Int
  rollNumber     Int
  isCurrent      Boolean             @default(true)
  promotedFromId Int?
  promotionDate  DateTime?
  status         EnrollmentStatus    @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  results        Result[]
  smsLogs        SmsLog[]
  academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  promotedFrom   StudentEnrollment?  @relation("PromotionHistory", fields: [promotedFromId], references: [id])
  promotions     StudentEnrollment[] @relation("PromotionHistory")
  section        Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentFees StudentFee[]

  @@unique([studentId, academicYearId])
  @@unique([academicYearId, classId, sectionId, rollNumber])
}

model Subject {
  id            Int            @id @default(autoincrement())
  code          String         @unique
  name          String
  fullMarks     Int
  passMarks     Int
  credit        Float?
  isOptional    Boolean        @default(false)
  classSubjects ClassSubject[]
  examSchedules ExamSchedule[]
  resultDetails ResultDetail[]
}

model ClassSubject {
  id        Int      @id @default(autoincrement())
  classId   Int
  sectionId Int?
  subjectId Int
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, sectionId, subjectId])
}

model Exam {
  id             Int            @id @default(autoincrement())
  academicYearId Int
  name           String
  examTypeId     Int
  startDate      DateTime?
  endDate        DateTime?
  isPublished    Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  smsSentAt      DateTime?
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  examType       ExamType       @relation(fields: [examTypeId], references: [id])
  schedules      ExamSchedule[]
  results        Result[]
  smsLogs        SmsLog[]
}

model ExamType {
  id     Int    @id @default(autoincrement())
  name   String
  weight Float?
  exams  Exam[]
}

model ExamSchedule {
  id         Int      @id @default(autoincrement())
  examId     Int
  subjectId  Int
  classId    Int
  sectionId  Int?
  examDate   DateTime
  startTime  DateTime
  endTime    DateTime
  roomNumber String?
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examId, subjectId, classId])
}

model Result {
  id                  Int               @id @default(autoincrement())
  studentEnrollmentId Int
  examId              Int
  totalMarks          Float
  percentage          Float
  grade               String
  gradePoint          Float
  position            Int?
  remarks             String?
  isPublished         Boolean           @default(false)
  publishedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  exam                Exam              @relation(fields: [examId], references: [id], onDelete: Cascade)
  enrollment          StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  details             ResultDetail[]

  @@unique([studentEnrollmentId, examId])
}

model ResultDetail {
  id             Int     @id @default(autoincrement())
  resultId       Int
  subjectId      Int
  writtenMarks   Float?
  mcqMarks       Float?
  practicalMarks Float?
  vivaMarks      Float?
  totalMarks     Float
  grade          String
  gradePoint     Float
  result         Result  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  subject        Subject @relation(fields: [subjectId], references: [id])

  @@unique([resultId, subjectId])
}

model GradingScale {
  id             Int          @id @default(autoincrement())
  academicYearId Int
  minPercentage  Float
  maxPercentage  Float
  grade          String
  gradePoint     Float
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, minPercentage])
}

model SmsLog {
  id                  Int       @id @default(autoincrement())
  studentEnrollmentId Int
  examId              Int?      // optional — Fee SMS এ null থাকবে
  studentFeeId        Int?      // Fee SMS এর জন্য
  type                String    @default("RESULT") // RESULT | FEE_PAYMENT | FEE_DUE
  phone               String
  message             String
  status              SmsStatus @default(PENDING)
  providerMessageId   String?
  errorMessage        String?
  attemptCount        Int       @default(0)
  sentAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  exam                Exam?             @relation(fields: [examId], references: [id], onDelete: SetNull)
  enrollment          StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  studentFee          StudentFee?       @relation(fields: [studentFeeId], references: [id], onDelete: SetNull)

  @@unique([studentEnrollmentId, examId])
  @@index([examId, status])
  @@index([studentEnrollmentId, type])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  GUARDIAN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  COMPLETED
  LEFT
}

enum SmsStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
}


model FeeType {
  id          Int            @id @default(autoincrement())
  name        String         @unique      // TUITION, EXAMINATION, TRANSPORT
  displayName String                       // "মাসিক বেতন", "পরীক্ষা ফি", "পরিবহন ফি"
  frequency   FeeFrequency   @default(MONTHLY)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  structures  FeeStructure[]
  studentFees StudentFee[]
}



model FeeStructure {
  id             Int          @id @default(autoincrement())
  feeTypeId      Int
  academicYearId Int
  classId        Int
  amount         Float
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  feeType        FeeType      @relation(fields: [feeTypeId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  studentFees    StudentFee[]

  @@unique([feeTypeId, academicYearId, classId])
}  



model StudentFee {
  id                  Int               @id @default(autoincrement())
  studentEnrollmentId Int
  feeStructureId      Int
  feeTypeId           Int
  amount              Float             // মূল পরিমাণ
  discount            Float             @default(0)
  fine                Float             @default(0)
  payableAmount       Float             // amount + fine - discount
  paidAmount          Float             @default(0)
  status              FeeStatus         @default(PENDING)
  month               Int?              // 1-12 (মাসিক ফি হলে)
  year                Int?
  dueDate             DateTime?
  remarks             String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  enrollment          StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  feeStructure        FeeStructure      @relation(fields: [feeStructureId], references: [id])
  feeType             FeeType           @relation(fields: [feeTypeId], references: [id])
  payments            FeePayment[]
  smsLogs SmsLog[]

  @@unique([studentEnrollmentId, feeTypeId, month, year], name: "unique_student_fee_period")
  @@index([studentEnrollmentId, status])
  @@index([status])
  @@index([feeTypeId, month, year])
  @@index([status, dueDate])
}



model FeePayment {
  id            Int         @id @default(autoincrement())
  studentFeeId  Int
  amount        Float
  paidAt        DateTime    @default(now())
  receivedById  Int?        // কোন অ্যাডমিন টাকা নিয়েছে
  remarks       String?
  createdAt     DateTime    @default(now())

  studentFee    StudentFee  @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  receivedBy    Admin?      @relation(fields: [receivedById], references: [id])

  @@index([studentFeeId])
  @@index([paidAt])
}


enum FeeFrequency {
  MONTHLY
  YEARLY
  ONE_TIME
  PER_EXAM
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  WAIVED
  OVERDUE
} 